LOVE_DOVES_LISTEN_ADDR=:8787
LOVE_DOVES_DATA_DIR=/data
# Required only until the first mailbox has been created; remove it afterward.
LOVE_DOVES_BOOTSTRAP_TOKEN=
# Exact OAuth-authenticated operator address. Leave empty to disable /admin/.
LOVE_DOVES_ADMIN_EMAIL=
# Optional after creating a Firebase project and external service-account file:
# FCM_PROJECT_ID=
# GOOGLE_APPLICATION_CREDENTIALS=/run/secrets/firebase-service-account.json
